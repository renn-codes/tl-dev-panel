<Project Sdk="Uno.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net9.0-browserwasm</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <UnoSingleProject>true</UnoSingleProject>
    <ApplicationTitle>Team Ligma Development Panel</ApplicationTitle>
    <ApplicationId>com.teamligma.devpanel</ApplicationId>
    <ApplicationDisplayVersion>1.7.2</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationPublisher>Team Ligma</ApplicationPublisher>
    <Description>Team Ligma Development Panel - AzerothCore build and server console suite.</Description>
    <Version>1.7.2</Version>
    <UnoFeatures>
      Mvvm;
      SkiaRenderer;
    </UnoFeatures>
    <!-- Custom page with the themed loading screen (Platforms/WebAssembly/wwwroot/loading/) -->
    <WasmShellIndexHtmlPath>$(MSBuildThisFileDirectory)Platforms/WebAssembly/index.html</WasmShellIndexHtmlPath>
    <NoWarn>$(NoWarn);CA1416;MVVMTK0045;Uno0001</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <!-- Loading-screen assets: published into the app package, where index.html's ./ paths resolve. -->
    <Content Include="Platforms/WebAssembly/loading/**" Link="loading/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../../Shared/Dtos.cs" Link="Shared/Dtos.cs" />
  </ItemGroup>
</Project>
