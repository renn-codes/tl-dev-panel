<UserControl x:Class="TeamLigma.Panel.Views.ConsolePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:TeamLigma.Panel.Controls">
  <Border Style="{StaticResource TlCardStyle}" Padding="14,12">
    <Grid RowSpacing="10">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Grid ColumnSpacing="8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <TextBlock x:Name="TitleText" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TlText}" VerticalAlignment="Center" />
          <Border x:Name="StatePill" CornerRadius="10" Padding="9,2" Background="#555450" VerticalAlignment="Center">
            <TextBlock x:Name="StateText" FontSize="11.5" FontWeight="SemiBold" Foreground="White" Text="Stopped" />
          </Border>
        </StackPanel>
        <TextBlock x:Name="CommandText" Grid.Column="1" Margin="4,0,0,0" Style="{StaticResource TlMonoText}" Foreground="{StaticResource TlTextMuted}" VerticalAlignment="Center" FontSize="11.5" />
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
          <Button x:Name="ExtraButton" Visibility="Collapsed" Padding="10,4" FontSize="12.5" Click="OnExtra" />
          <Button x:Name="StartButton" Style="{StaticResource AccentButtonStyle}" Padding="12,4" FontSize="12.5" Content="▶ Start" Click="OnStart" />
          <Button x:Name="ClearButton" Padding="10,4" FontSize="12.5" Content="Clear" Click="OnClear" ToolTipService.ToolTip="Clear this console's scrollback" />
        </StackPanel>
      </Grid>

      <!-- how the console is connected (shown for sessions started outside the panel) -->
      <Border x:Name="AttachBanner" Grid.Row="1" Visibility="Collapsed" CornerRadius="6" Padding="10,5" BorderThickness="1"
              Background="#2A2F38" BorderBrush="#3D5A80">
        <TextBlock x:Name="AttachText" FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource TlTextSecondary}" />
      </Border>

      <c:TerminalView x:Name="Term" Grid.Row="2" MaxLines="6000" />

      <Grid x:Name="InputRow" Grid.Row="3" ColumnSpacing="8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="PromptText" FontFamily="{StaticResource TlMono}" Foreground="{StaticResource TlAccent}" FontWeight="Bold" VerticalAlignment="Center" Text="&gt;" />
        <TextBox x:Name="Input" Grid.Column="1" FontFamily="{StaticResource TlMono}" FontSize="13" PlaceholderText="Type a command and press Enter" KeyDown="OnInputKeyDown" />
        <PasswordBox x:Name="Password" Grid.Column="1" Visibility="Collapsed" PlaceholderText="MySQL root password, then Enter" KeyDown="OnPasswordKeyDown" />
        <c:CtrlCCatcher x:Name="CtrlCBox" Grid.Column="1" Visibility="Collapsed" />
        <Button x:Name="SendButton" Grid.Column="2" Content="Send" Padding="14,5" Click="OnSend" />
        <Button x:Name="SqlButton" Grid.Column="3" Visibility="Collapsed" Content="Run .sql script…" Padding="12,5" Click="OnRunSql" />
      </Grid>
    </Grid>
  </Border>
</UserControl>
