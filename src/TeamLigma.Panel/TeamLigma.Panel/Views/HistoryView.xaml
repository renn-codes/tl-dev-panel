<UserControl x:Class="TeamLigma.Panel.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Padding="28,24,28,24" RowSpacing="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Grid>
      <StackPanel Spacing="2">
        <TextBlock Style="{StaticResource TlPageTitle}" Text="History" />
        <TextBlock x:Name="Subtitle" Foreground="{StaticResource TlTextMuted}" Text="Every recorded build, newest first." />
      </StackPanel>
      <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal" Spacing="8">
        <Button Click="OnWhyNotListed" Content="Why isn't my build listed?"
                ToolTipService.ToolTip="Shows every ninja process the panel can see, and whether it is followed" />
        <Button Click="OnRefresh" Content="↻  Refresh" />
      </StackPanel>
    </Grid>
    <Border Grid.Row="1" Style="{StaticResource TlCardStyle}" Padding="0">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Grid x:Name="HeaderRow" Padding="18,12" BorderBrush="{StaticResource TlCardBorder}" BorderThickness="0,0,0,1" />
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
          <StackPanel x:Name="Rows" />
        </ScrollViewer>
        <TextBlock x:Name="Empty" Grid.Row="1" Margin="18" Foreground="{StaticResource TlTextMuted}" Text="No builds recorded yet." Visibility="Collapsed" />
      </Grid>
    </Border>
  </Grid>
</UserControl>
