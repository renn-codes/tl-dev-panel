<UserControl x:Class="TeamLigma.Panel.Views.BuildConsoleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="using:TeamLigma.Panel.Views"
             xmlns:c="using:TeamLigma.Panel.Controls">
  <Grid Padding="28,24,28,24" RowSpacing="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" MinHeight="260" />
    </Grid.RowDefinitions>
    <StackPanel Spacing="2">
      <TextBlock Style="{StaticResource TlPageTitle}" Text="Build Console" />
      <TextBlock Foreground="{StaticResource TlTextMuted}" x:Name="Subtitle" Text="Prepare, compile, install and clean the AzerothCore tree." />
    </StackPanel>

    <Border Grid.Row="1" Style="{StaticResource TlCardStyle}" Padding="16,12">
      <StackPanel Spacing="12">
      <Grid ColumnSpacing="10">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Button x:Name="StartButton" Style="{StaticResource AccentButtonStyle}" Height="40" Padding="18,0" VerticalAlignment="Center" VerticalContentAlignment="Center" Click="OnStart"
                ToolTipService.ToolTip="ninja -j$(( $(nproc) - 1 )), then ninja install">
          <TextBlock Text="▶  Start Build" LineHeight="18" LineStackingStrategy="BlockLineHeight" VerticalAlignment="Center" FontWeight="SemiBold" />
        </Button>
        <Button x:Name="ConfigureButton" Grid.Column="1" Height="40" Padding="16,0" VerticalAlignment="Center" VerticalContentAlignment="Center" Click="OnConfigure"
                ToolTipService.ToolTip="cmake ../ -G Ninja -DCMAKE_INSTALL_PREFIX=/roc/claude/live/ ...">
          <TextBlock Text="Prepare (CMake)" LineHeight="18" LineStackingStrategy="BlockLineHeight" VerticalAlignment="Center" />
        </Button>
        <Button x:Name="CleanButton" Grid.Column="2" Height="40" Padding="16,0" VerticalAlignment="Center" VerticalContentAlignment="Center" Click="OnClean" ToolTipService.ToolTip="ninja -t clean">
          <TextBlock Text="Clean" LineHeight="18" LineStackingStrategy="BlockLineHeight" VerticalAlignment="Center" />
        </Button>
        <TextBlock x:Name="TaskText" Grid.Column="3" VerticalAlignment="Center" Margin="12,0" Foreground="{StaticResource TlTextMuted}" TextTrimming="CharacterEllipsis" />
        <Button x:Name="StopButton" Grid.Column="4" Height="40" Padding="16,0" VerticalAlignment="Center" VerticalContentAlignment="Center" Click="OnStop" Background="{StaticResource TlDanger}" Foreground="White">
          <Button.Resources>
            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#DC4F48" />
            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#A8332E" />
            <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="White" />
            <SolidColorBrush x:Key="ButtonForegroundPressed" Color="White" />
            <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="#3A2A28" />
          </Button.Resources>
          <TextBlock Text="■  Force Stop" LineHeight="18" LineStackingStrategy="BlockLineHeight" VerticalAlignment="Center" FontWeight="SemiBold" />
        </Button>
      </Grid>
      <Grid ColumnSpacing="10" BorderBrush="{StaticResource TlCardBorder}" BorderThickness="0,1,0,0" Padding="0,10,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Style="{StaticResource TlLabel}" Text="BUILD DIRECTORY" VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <TextBlock x:Name="BuildDirText" Style="{StaticResource TlMonoText}" Foreground="{StaticResource TlText}" FontSize="13" VerticalAlignment="Center" Text="—" />
          <Border x:Name="BuildDirPill" CornerRadius="10" Padding="9,2" Background="#555450" VerticalAlignment="Center">
            <TextBlock x:Name="BuildDirState" FontSize="11.5" FontWeight="SemiBold" Foreground="White" Text="…" />
          </Border>
        </StackPanel>
        <Button x:Name="BrowseButton" Grid.Column="2" Height="32" Padding="14,0" VerticalContentAlignment="Center" Content="Change…" Click="OnBrowse"
                ToolTipService.ToolTip="Pick the Ninja build directory on the server" />
      </Grid>
      <Grid ColumnSpacing="14" BorderBrush="{StaticResource TlCardBorder}" BorderThickness="0,1,0,0" Padding="0,10,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="320" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <TextBlock Style="{StaticResource TlLabel}" Text="CPU THREADS" VerticalAlignment="Center" Width="104" />
        <Slider x:Name="JobsSlider" Grid.Column="1" Minimum="1" Maximum="4" StepFrequency="1" TickFrequency="1"
                TickPlacement="Outside" SnapsTo="Ticks" VerticalAlignment="Center" ValueChanged="OnJobsChanged" />
        <TextBlock x:Name="JobsValue" Grid.Column="2" FontFamily="{StaticResource TlMono}" FontSize="15" FontWeight="SemiBold"
                   Foreground="{StaticResource TlText}" VerticalAlignment="Center" MinWidth="64" Text="-j?" />
        <CheckBox x:Name="JobsAuto" Grid.Column="3" Content="Auto" VerticalAlignment="Center" MinWidth="0"
                  Checked="OnJobsAutoChanged" Unchecked="OnJobsAutoChanged"
                  ToolTipService.ToolTip="Automatic: one less than the number of logical CPUs (ninja -j$(( $(nproc) - 1 )))" />
        <TextBlock x:Name="CpuInfoText" Grid.Column="4" Style="{StaticResource TlLabel}" VerticalAlignment="Center" TextWrapping="Wrap" />
      </Grid>
      </StackPanel>
    </Border>

    <Border Grid.Row="2" Style="{StaticResource TlCardStyle}">
      <StackPanel Spacing="12">
        <TextBlock Style="{StaticResource TlCardTitle}" Text="BUILD STATUS" />
        <v:BuildDash x:Name="Dash" MaxObjects="8" />
      </StackPanel>
    </Border>

    <Grid Grid.Row="3" RowSpacing="8">
      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
      <Grid>
        <StackPanel Orientation="Horizontal" Spacing="10">
          <TextBlock Style="{StaticResource TlCardTitle}" Text="TERMINAL" VerticalAlignment="Center" />
          <Border x:Name="SourcePill" Background="{StaticResource TlAccentSoft}" CornerRadius="10" Padding="10,2">
            <TextBlock x:Name="SourceText" FontSize="12" Foreground="{StaticResource TlText}" Text="—" />
          </Border>
        </StackPanel>
        <TextBlock x:Name="LiveText" HorizontalAlignment="Right" FontSize="12" Foreground="{StaticResource TlTextMuted}" VerticalAlignment="Center" />
      </Grid>
      <c:TerminalView x:Name="Term" Grid.Row="1" MaxLines="8000" PlaceholderText="Build and task output will stream here." />
    </Grid>
  </Grid>
</UserControl>
