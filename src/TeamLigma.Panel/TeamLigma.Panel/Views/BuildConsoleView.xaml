<UserControl x:Class="TeamLigma.Panel.Views.BuildConsoleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="using:TeamLigma.Panel.Views"
             xmlns:c="using:TeamLigma.Panel.Controls">
  <Grid Padding="28,24,28,24" RowSpacing="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" MinHeight="260" />
    </Grid.RowDefinitions>
    <StackPanel Spacing="2">
      <TextBlock Style="{StaticResource TlPageTitle}" Text="Build Console" />
      <TextBlock Foreground="{StaticResource TlTextMuted}" Text="Prepare, compile, install and clean the AzerothCore tree at /roc/claude/claude-acore." />
    </StackPanel>

    <Border Grid.Row="1" Style="{StaticResource TlCardStyle}" Padding="16,12">
      <Grid ColumnSpacing="10">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Button x:Name="StartButton" Style="{StaticResource AccentButtonStyle}" Padding="18,8" Click="OnStart"
                ToolTipService.ToolTip="screen -dmS build ninja-dash /roc/claude/claude-acore/build -- -j8 -k 0">
          <TextBlock Text="▶  Start Build" FontWeight="SemiBold" />
        </Button>
        <Button x:Name="ConfigureButton" Grid.Column="1" Padding="16,8" Click="OnConfigure"
                ToolTipService.ToolTip="cmake ../ -G Ninja -DCMAKE_INSTALL_PREFIX=/roc/claude/live/ ...">
          <TextBlock Text="⚙  Prepare (CMake)" />
        </Button>
        <Button x:Name="CleanButton" Grid.Column="2" Padding="16,8" Click="OnClean" ToolTipService.ToolTip="ninja -t clean">
          <TextBlock Text="✦  Clean" />
        </Button>
        <TextBlock x:Name="TaskText" Grid.Column="3" VerticalAlignment="Center" Margin="12,0" Foreground="{StaticResource TlTextMuted}" TextTrimming="CharacterEllipsis" />
        <Button x:Name="StopButton" Grid.Column="4" Padding="16,8" Click="OnStop" Background="{StaticResource TlDanger}" Foreground="White">
          <Button.Resources>
            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#DC4F48" />
            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#A8332E" />
            <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="White" />
            <SolidColorBrush x:Key="ButtonForegroundPressed" Color="White" />
            <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="#3A2A28" />
          </Button.Resources>
          <TextBlock Text="■  Force Stop" FontWeight="SemiBold" />
        </Button>
      </Grid>
    </Border>

    <Border Grid.Row="2" Style="{StaticResource TlCardStyle}">
      <StackPanel Spacing="12">
        <TextBlock Style="{StaticResource TlCardTitle}" Text="BUILD STATUS" />
        <v:BuildDash x:Name="Dash" MaxObjects="8" />
      </StackPanel>
    </Border>

    <Grid Grid.Row="3" RowSpacing="8">
      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
      <Grid>
        <StackPanel Orientation="Horizontal" Spacing="10">
          <TextBlock Style="{StaticResource TlCardTitle}" Text="TERMINAL" VerticalAlignment="Center" />
          <Border x:Name="SourcePill" Background="{StaticResource TlAccentSoft}" CornerRadius="10" Padding="10,2">
            <TextBlock x:Name="SourceText" FontSize="12" Foreground="{StaticResource TlText}" Text="—" />
          </Border>
        </StackPanel>
        <TextBlock x:Name="LiveText" HorizontalAlignment="Right" FontSize="12" Foreground="{StaticResource TlTextMuted}" VerticalAlignment="Center" />
      </Grid>
      <c:TerminalView x:Name="Term" Grid.Row="1" MaxLines="8000" PlaceholderText="Build and task output will stream here." />
    </Grid>
  </Grid>
</UserControl>
