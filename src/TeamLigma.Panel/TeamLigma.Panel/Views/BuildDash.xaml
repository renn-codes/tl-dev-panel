<UserControl x:Class="TeamLigma.Panel.Views.BuildDash"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:TeamLigma.Panel.Controls">
  <StackPanel Spacing="14">
    <Grid ColumnSpacing="24">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <StackPanel Spacing="2">
        <TextBlock Style="{StaticResource TlLabel}" Text="BUILD" />
        <TextBlock x:Name="NumberText" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource TlText}" Text="—" />
      </StackPanel>
      <StackPanel Grid.Column="1" Spacing="2">
        <TextBlock Style="{StaticResource TlLabel}" Text="STARTED" />
        <TextBlock x:Name="StartedText" Style="{StaticResource TlValue}" Text="—" Margin="0,6,0,0" />
      </StackPanel>
      <StackPanel Grid.Column="2" Spacing="2">
        <TextBlock Style="{StaticResource TlLabel}" Text="ELAPSED" />
        <TextBlock x:Name="ElapsedText" Style="{StaticResource TlValue}" Text="—" Margin="0,6,0,0" />
      </StackPanel>
      <StackPanel Grid.Column="3" Spacing="2" HorizontalAlignment="Right">
        <TextBlock Style="{StaticResource TlLabel}" Text="STATUS" HorizontalAlignment="Right" />
        <Border x:Name="StatusPill" CornerRadius="12" Padding="12,4" Margin="0,4,0,0" Background="#555450" HorizontalAlignment="Right">
          <TextBlock x:Name="StatusText" Text="Idle" FontWeight="SemiBold" FontSize="13" Foreground="White" />
        </Border>
      </StackPanel>
    </Grid>

    <StackPanel Orientation="Horizontal" Spacing="8">
      <TextBlock Style="{StaticResource TlLabel}" Text="DIRECTORY" VerticalAlignment="Center" />
      <TextBlock x:Name="DirText" Style="{StaticResource TlMonoText}" VerticalAlignment="Center" Text="—" />
      <Border x:Name="ExternalPill" Visibility="Collapsed" CornerRadius="10" Padding="9,2" Background="#3D5A80" VerticalAlignment="Center"
              ToolTipService.ToolTip="Started outside the panel. Its own output can't be captured; finished steps come from .ninja_log.">
        <TextBlock Text="External" FontSize="11.5" FontWeight="SemiBold" Foreground="White" />
      </Border>
    </StackPanel>

    <StackPanel Spacing="6">
      <Grid>
        <TextBlock Style="{StaticResource TlLabel}" Text="OVERALL PROGRESS" />
        <TextBlock x:Name="OverallText" Style="{StaticResource TlLabel}" HorizontalAlignment="Right" Text="" />
      </Grid>
      <c:Bar x:Name="OverallBar" BarHeight="12" />
      <Grid x:Name="InstallRow" Visibility="Collapsed" Margin="0,4,0,0" RowSpacing="6">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <TextBlock Style="{StaticResource TlLabel}" Text="INSTALL" />
        <TextBlock x:Name="InstallText" Style="{StaticResource TlLabel}" HorizontalAlignment="Right" />
        <c:Bar x:Name="InstallBar" Grid.Row="1" BarHeight="6" />
      </Grid>
    </StackPanel>

    <StackPanel Spacing="4">
      <TextBlock Style="{StaticResource TlLabel}" Text="CURRENT STEP" />
      <TextBlock x:Name="StepText" Style="{StaticResource TlMonoText}" Foreground="{StaticResource TlText}" Text="—" />
    </StackPanel>

    <StackPanel x:Name="ObjectsSection" Spacing="8">
      <Grid>
        <TextBlock Style="{StaticResource TlLabel}" Text="CURRENTLY BUILDING" />
        <TextBlock x:Name="ObjectsCount" Style="{StaticResource TlLabel}" HorizontalAlignment="Right" />
      </Grid>
      <StackPanel x:Name="ObjectsPanel" Spacing="8" />
      <TextBlock x:Name="NoObjects" Style="{StaticResource TlMonoText}" Foreground="{StaticResource TlTextMuted}" Text="Nothing compiling right now." />
    </StackPanel>
  </StackPanel>
</UserControl>
