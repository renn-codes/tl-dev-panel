{
  "Logging": { "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning" } },
  "Urls": "http://127.0.0.1:5267",
  "Panel": {
    "SourceDir": "/roc/claude/claude-acore",
    "BuildDir": "/roc/claude/claude-acore/build",
    "InstallDir": "/roc/claude/live",
    "BinDir": "/roc/claude/live/bin",
    "DataHome": "/roc/claude/panel-data",
    "BuildCommand": "screen -dmS build ninja-dash /roc/claude/claude-acore/build -- -j8 -k 0",
    "ConfigureCommand": "cmake ../ -G Ninja -DCMAKE_INSTALL_PREFIX=/roc/claude/live/ -DCMAKE_C_COMPILER=/usr/bin/clang -DCMAKE_CXX_COMPILER=/usr/bin/clang++ -DWITH_WARNINGS=0 -DTOOLS_BUILD=all -DSCRIPTS=static -DMODULES=static",
    "CleanCommand": "ninja -t clean",
    "WorldCommand": "screen -dmS world ./worldserver",
    "AuthCommand": "screen -dmS auth ./authserver",
    "MySqlCommand": "screen -dmS mysql mysql -uroot -p",
    "DiskPath": "/roc"
  }
}
